{
    "name": "oysterai/oyster-wc-interakt",
    "description": "Development tooling for the Oyster WhatsApp for WooCommerce plugin. Not shipped: the plugin autoloads its own classes and has no runtime dependencies.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Oyster\\WcInterakt\\": "includes/",
            "Oyster\\WcInterakt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
